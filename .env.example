NODE_ENV=development
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

POSTGRES_DB=auto_mb
POSTGRES_ADMIN_USER=auto_mb_owner
POSTGRES_ADMIN_PASSWORD=local-owner-change-me
AUTO_MB_APP_DB_PASSWORD=local-app-change-me
DATABASE_ADMIN_URL=postgres://auto_mb_owner:local-owner-change-me@127.0.0.1:5432/auto_mb
DATABASE_URL=postgres://auto_mb_app:local-app-change-me@127.0.0.1:5432/auto_mb

GOTENBERG_URL=http://127.0.0.1:3001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=auto-mb-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only-change-me

# Required before authentication is enabled. Production must reject placeholders.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Finding 36: MFA refusals for privilege holders (owner role or any document
# authority). The gate is always computed and reported by /api/me; setting
# this to true additionally REFUSES tenant requests and two-factor disable
# for required-but-unenrolled accounts. Default off (dark deploy).
# MFA_ENFORCE=true

# Optional: backup freshness on /metrics. Path to the last-success marker
# written by scripts/backup.sh; unset or unreadable omits the
# backup_last_success_timestamp_seconds series entirely (never a fake 0).
BACKUP_MARKER_PATH=./backups/last-success

# Optional Whitebooks GRP/GSP statutory transport. Leave every WHITEBOOKS_*
# value unset to keep explicit manual-compatibility mode. Never copy tokens,
# SEK values, passwords, or client secrets into source control.
# WHITEBOOKS_ENABLED=true
# WHITEBOOKS_ENVIRONMENT=sandbox
# WHITEBOOKS_EMAIL=replace-me
# WHITEBOOKS_USERNAME=replace-me
# WHITEBOOKS_PASSWORD=replace-me
# WHITEBOOKS_CLIENT_ID=replace-me
# WHITEBOOKS_CLIENT_SECRET=replace-me
# Separate E-way Bill API client pair. Required for EWB cancellation only.
# WHITEBOOKS_EWAY_CLIENT_ID=replace-me
# WHITEBOOKS_EWAY_CLIENT_SECRET=replace-me
# WHITEBOOKS_IP_ADDRESS=203.0.113.10
# WHITEBOOKS_GSTIN=27AAAAA0000A1Z5
# WHITEBOOKS_IRP=NIC1
# WHITEBOOKS_TIMEOUT_MS=10000
