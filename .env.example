NODE_ENV=development
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# Concurrency and socket limits. The defaults live in
# apps/server/src/app.ts (SERVER_LIMITS) and are what an unset variable
# gets; set them only to depart from those. DATABASE_POOL_MAX caps the
# connections ONE instance may hold — count it twice per instance (the
# application pool and Better Auth's) against the server's
# max_connections. REQUEST_TIMEOUT_MS must stay above the slowest
# synchronous route (PDF rendering through Gotenberg), and
# KEEP_ALIVE_TIMEOUT_MS above the fronting proxy's idle timeout, so the
# server is never the side that races the proxy into a reset.
# DATABASE_POOL_MAX=20
# REQUEST_TIMEOUT_MS=120000
# KEEP_ALIVE_TIMEOUT_MS=72000

POSTGRES_DB=auto_mb
POSTGRES_ADMIN_USER=auto_mb_owner
POSTGRES_ADMIN_PASSWORD=local-owner-change-me
AUTO_MB_APP_DB_PASSWORD=local-app-change-me
DATABASE_ADMIN_URL=postgres://auto_mb_owner:local-owner-change-me@127.0.0.1:5432/auto_mb
DATABASE_URL=postgres://auto_mb_app:local-app-change-me@127.0.0.1:5432/auto_mb

GOTENBERG_URL=http://127.0.0.1:3001

# Optional: full path to Poppler's pdftotext. LOA extraction verifies the
# binary is Poppler's and refuses to run otherwise, because Xpdf ships a
# same-named binary whose -layout output the parser reads incorrectly (null
# item units). Set this only when another toolchain shadows Poppler on PATH
# (e.g. Git-for-Windows/MSYS2 at /mingw64/bin/pdftotext). See
# docs/DEPENDENCIES.md, "pdftotext must be Poppler's".
# AUTO_MB_PDFTOTEXT=/usr/bin/pdftotext
# Directory of PEM trust anchors for verifying digital signatures on
# inbound railway PDFs. Only CCA India ROOT certificates belong at the top
# level; an `intermediates/` sub-directory completes chains without
# granting trust.
#
# PRODUCTION needs nothing here: the image ships deploy/trust-anchors at
# /etc/auto-mb/pdf-trust and sets this variable to it, so a stock
# deployment can already say who signed a document
# (deploy/trust-anchors/README.md records each certificate's provenance and
# SHA-256). Set this only to point somewhere else.
#
# LOCALLY, give an ABSOLUTE path to the checkout's deploy/trust-anchors —
# e.g. /home/you/auto-mb/deploy/trust-anchors. A relative value is resolved
# against the server process's working directory, which is apps/server
# under `pnpm dev`, not the repository root, and a configured path that
# cannot be read REFUSES TO START rather than silently degrading every
# railway document to "issuer not checked".
#
# Leaving it unset is a legitimate posture and not a silent one: every
# signature is still verified cryptographically and the verdict is stored,
# but no document can reach the "signed and intact" state and the review
# screen says no certifying authorities are installed. See
# docs/OPERATIONS.md, "Digital-signature trust anchors".
# AUTO_MB_PDF_TRUST_ANCHORS=/absolute/path/to/deploy/trust-anchors

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=auto-mb-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only-change-me

# Required before authentication is enabled. Production must reject placeholders.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Outbound mail. Password recovery is the only thing that sends mail today,
# and it is not optional outside development and test: two-factor
# authentication is mandatory for anyone holding document authority, so an
# account whose password is forgotten has no other way back in. The server
# refuses to start in production unless BOTH values are set.
#
# SMTP_URL is a full nodemailer connection URL — smtp:// for a relay on the
# private network, smtps:// for an authenticated provider. Put the mailbox
# credentials in the deployment secret store, never in source control.
# MAIL_FROM must be an address the relay will accept as a sender.
#
# SMTP_URL=smtp://mail-relay.internal:25
# SMTP_URL=smtps://USER:PASSWORD@smtp.provider.example:465
# MAIL_FROM=Auto-MB <no-reply@contractor.example>

# clamd endpoint for upload malware scanning. Leaving it unset is a
# development posture only: the server then registers every upload route
# behind a no-op scanner, so nothing is scanned. Any process that is not an
# explicit NODE_ENV=development or NODE_ENV=test run refuses to boot without
# it (docs/SECURITY.md). The production compose sets it to the ClamAV
# service.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Finding 36: MFA refusals for privilege holders (owner role or any document
# authority). The gate is always computed and reported by /api/me; setting
# this to true additionally REFUSES tenant requests and two-factor disable
# for required-but-unenrolled accounts. Default off (dark deploy).
# MFA_ENFORCE=true

# Optional: backup freshness on /metrics. Path to the last-success marker
# written by scripts/backup.sh; unset or unreadable omits the
# backup_last_success_timestamp_seconds series entirely (never a fake 0).
BACKUP_MARKER_PATH=./backups/last-success

# Optional Whitebooks GRP/GSP statutory transport. Leave every WHITEBOOKS_*
# value unset to keep explicit manual-compatibility mode. Never copy tokens,
# SEK values, passwords, or client secrets into source control.
# WHITEBOOKS_ENABLED=true
# WHITEBOOKS_ENVIRONMENT=sandbox
# WHITEBOOKS_EMAIL=replace-me
# WHITEBOOKS_USERNAME=replace-me
# WHITEBOOKS_PASSWORD=replace-me
# WHITEBOOKS_CLIENT_ID=replace-me
# WHITEBOOKS_CLIENT_SECRET=replace-me
# Separate E-way Bill API client pair. Required for EWB cancellation only.
# WHITEBOOKS_EWAY_CLIENT_ID=replace-me
# WHITEBOOKS_EWAY_CLIENT_SECRET=replace-me
# WHITEBOOKS_IP_ADDRESS=203.0.113.10
# WHITEBOOKS_GSTIN=27AAAAA0000A1Z5
# WHITEBOOKS_IRP=NIC1
# WHITEBOOKS_TIMEOUT_MS=10000
