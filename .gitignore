node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo
.eslintcache
.env
.env.*
!.env.example
!.env.production.example
.DS_Store
*.log
.tmp/
artifacts/
test-results/
playwright-report/
local-data/

# Real IREPS award letters and material derived from them must never enter
# the tree; only the reviewed text fixtures under packages/loa-parser/fixtures
# are committed. Carried over from the legacy repository's data-protection
# posture.
*.loa.pdf
fixtures-raw/

# Local opt-out for the caveman SessionStart hook. Presence of this file
# silences .claude/hooks/caveman-activate.sh for one working tree without
# changing the committed default for everyone else.
.claude/hooks/.caveman-off

# Heavy third-party design skills arrive by `node scripts/fetch-skills.mjs`
# at the commits pinned in .claude/skills/PROVENANCE.md, not from git.
# The small skills (caveman, the ux-ui-agent-skills wrapper) stay tracked.
.claude/skills/impeccable/
.claude/skills/ux-designer/

# Agent worktrees are session-local working copies, never content.
.claude/worktrees/
