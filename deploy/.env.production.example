# Copy to deploy/.env.production and fill in real values. Every secret
# below must be generated fresh (e.g. `openssl rand -hex 32`) — never
# reuse these placeholders.
SITE_ADDRESS=mb.example.in
POSTGRES_PASSWORD=change-me-strong-owner-password
AUTO_MB_APP_DB_PASSWORD=change-me-strong-app-password
AUTH_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=change-me-long-random-metrics-token
# Two-factor enforcement for privilege holders (docs/SECURITY.md, finding 36).
# Must be true before the first design-partner account exists; false only
# while the deployment is being stood up.
MFA_ENFORCE=true
# Outbound mail for password recovery — the only thing the product sends,
# and not optional: the server refuses to start in production unless BOTH
# values are set (docs/SECURITY.md). SMTP_URL is a full nodemailer
# connection URL — smtp:// for a relay on the private network, smtps://
# for an authenticated provider; mailbox credentials live here with the
# other deployment secrets, never in source control. MAIL_FROM must be an
# address the relay will accept as a sender.
SMTP_URL=smtp://mail-relay.internal:25
MAIL_FROM=Auto-MB <no-reply@contractor.example>
# Optional Whitebooks transport. Keep disabled until every value is supplied
# through deployment secrets. E-way Bill cancellation uses a separate client pair.
WHITEBOOKS_ENABLED=false
WHITEBOOKS_ENVIRONMENT=sandbox
WHITEBOOKS_EMAIL=
WHITEBOOKS_USERNAME=
WHITEBOOKS_PASSWORD=
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
WHITEBOOKS_EWAY_CLIENT_ID=
WHITEBOOKS_EWAY_CLIENT_SECRET=
WHITEBOOKS_IP_ADDRESS=
WHITEBOOKS_GSTIN=
WHITEBOOKS_IRP=NIC1
WHITEBOOKS_TIMEOUT_MS=10000
# Optional WhatsApp Business transport for notifications (migration 0092).
# Keep disabled until Meta onboarding completes and every value is supplied
# through deployment secrets. Disabled is a working state, not a broken one:
# an organisation configures its own channel while the WABA is in review,
# and the screens say the deployment has no transport yet.
#
# WHATSAPP_APP_SECRET is what the public webhook address verifies delivery
# receipts against. It must be at least 32 characters, and the server
# refuses to start with a shorter one.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_VIA_BSP=false
# Notification email needs nothing here: it uses the SMTP_URL relay above,
# and the sender address is per organisation.
#
# Optional test account (docs/RUNBOOK.md, "Test user"). LEAVE THESE UNSET
# unless you want one: with both TEST_USER_EMAIL and TEST_USER_PASSWORD
# set, every deployment ensures a STANDING production account that holds
# the owner role and EVERY authority the membership table can grant, in an
# organisation named by TEST_USER_ORG (default "Test Organisation").
# Removing the variables later does NOT remove the account — the account is
# disabled or deleted deliberately, on the host, as the runbook describes.
# The password is only ever read; it is never logged, and an account that
# already exists keeps the password it has.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_ORG=
# Backup freshness (no value needed here): BACKUP_MARKER_PATH is fixed in
# docker-compose.prod.yml to /backup-status/last-success, backed by the host
# directory /var/lib/auto-mb/backup-status that the nightly backup cron
# writes via BACKUP_MARKER_DIR (docs/RUNBOOK.md §4).
#
# Nothing else belongs in this file. Three pieces of configuration live on
# the host rather than here, because they are read by processes that are
# not the application container:
#
#   * the nightly backup's settings — including
#     BACKUP_ENCRYPTION_PUBLIC_KEY and BACKUP_OFFHOST_COMMAND — are set in
#     the cron line itself (docs/RUNBOOK.md §4/§4a). This file is the
#     BACKUP_SECRETS_FILE that backup carries into the recovery set, so
#     losing the host does not lose AUTH_SECRET;
#   * Prometheus reads METRICS_TOKEN from
#     /var/lib/auto-mb/prometheus/secrets/metrics-token, because Prometheus
#     does not expand environment variables in its configuration
#     (docs/RUNBOOK.md §2/§6);
#   * Alertmanager reads its receiver credential from
#     /var/lib/auto-mb/alertmanager/secrets/, once an owner has chosen a
#     delivery channel (docs/RUNBOOK.md §6).
