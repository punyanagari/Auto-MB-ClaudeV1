# Auto-MB API server image. Build from the repository root:
#   docker compose -f deploy/docker-compose.prod.yml build
FROM node:22.16.0-alpine

# pdftotext (poppler-utils) is the LOA text-extraction system dependency
# (docs/DEPENDENCIES.md).
RUN apk add --no-cache poppler-utils

# Pinned directly rather than through corepack (see Dockerfile.web).
RUN npm install -g pnpm@11.17.0
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY apps/server ./apps/server
RUN pnpm install --frozen-lockfile --filter "@auto-mb/server..." --filter "@auto-mb/db..."

ENV NODE_ENV=production

# The object-store volume mounts at /data/objects; it must be writable
# by the unprivileged runtime user. A fresh named volume copies this
# directory's ownership; run `chown node /data/objects` once (as root)
# on any volume that predates the directory existing in the image.
RUN mkdir -p /data/objects && chown -R node:node /data

USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@auto-mb/server", "start"]
