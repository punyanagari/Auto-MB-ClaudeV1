# Auto-MB web front end: production bundle served by Caddy, which also
# terminates TLS and proxies /api to the server container.
# Base images carry their digest as well as their tag: a tag is a mutable
# pointer, and the Trivy gate in the deploy workflow can only mean
# something if the bytes it scanned are the bytes that ship. Renovate
# updates tag and digest together.
FROM node:22.16.0-alpine3.21@sha256:9f3ae04faa4d2188825803bf890792f33cc39033c9241fc6bb201149470436ca AS build
# Pinned directly rather than through corepack: corepack resolves the
# packageManager field by downloading pnpm and verifying npm's registry
# signature against keys baked into the corepack release, so an image
# whose bundled corepack predates a registry key rotation fails the
# build with an unrelated-looking signature error.
RUN npm install -g pnpm@11.17.0
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter "@auto-mb/web..." \
  && pnpm --filter @auto-mb/web build

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
# Upgrade the image's Alpine packages in place: the published image lags
# fixed advisories for its own OS layer. The Go-module findings compiled
# into the caddy binary itself are not fixable here; they are accepted
# individually in deploy/.trivyignore with their rationale.
RUN apk upgrade --no-cache
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/web
