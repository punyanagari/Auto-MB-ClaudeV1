{
  "name": "@auto-mb/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./explain": {
      "types": "./src/explain.ts",
      "default": "./src/explain.ts"
    }
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "check:migrations": "tsx src/check-migrations.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bootstrap": "tsx src/bootstrap.ts"
  },
  "dependencies": {
    "postgres": "3.4.9"
  }
}
